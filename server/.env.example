# ---------------------------------------------------------------
#  Copy this file to server/.env and fill in the values.
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Local install:  postgresql://postgres:password@localhost:5432/mail_automation
# Neon / Supabase: paste the pooled connection string they give you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mail_automation?schema=public"

# --- Secrets -----------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
ENCRYPTION_KEY=""

# --- URLs --------------------------------------------------------
PORT=4000
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"

# --- Google OAuth ------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: http://localhost:4000/api/mail-accounts/oauth/callback
# Enable the Gmail API for the project under "Enabled APIs & services".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/mail-accounts/oauth/callback"

# --- Stripe billing (optional) -----------------------------------
# Leave blank to run the app entirely on the Free plan.
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe`,
# or from the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=""

# One recurring monthly Price per paid plan (Products -> add product -> pricing).
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# --- Storage -----------------------------------------------------
UPLOAD_DIR="uploads"
MAX_UPLOAD_BYTES=15728640

# --- Worker tuning ----------------------------------------------
# How often the queue is polled, and how long one chunk may run before
# it checkpoints and yields (the replacement for the Apps Script 6-min cap).
WORKER_TICK_MS=5000
WORKER_CHUNK_BUDGET_MS=25000
WORKER_MESSAGE_DELAY_MS=60
